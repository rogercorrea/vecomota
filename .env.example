# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o ".env" real para um repositório público.

POSTGRES_USER=estudos
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=estudos_db

DATABASE_URL=postgresql://estudos:troque_esta_senha@db:5432/estudos_db

# Gere uma string aleatória longa, ex: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque_por_uma_string_aleatoria_longa

# Credenciais do Google Cloud Console (Console > APIs e Serviços > Credenciais > ID do cliente OAuth > Aplicativo da Web)
GOOGLE_CLIENT_ID=coloque_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=coloque_aqui
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

FRONTEND_URL=http://localhost:8000

# E-mails (separados por vírgula) que recebem acesso à tela de admin ao logar com Google
ADMIN_EMAILS=voce@gmail.com
